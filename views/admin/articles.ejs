<%- include('_header', { title: 'Артикли' , page: 'articles' }) %>

  <style>
    .tab-bar {
      display: flex;
      gap: 4px;
      margin-bottom: 20px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 6px;
    }

    .tab-btn {
      flex: 1;
      padding: 8px 16px;
      border: none;
      border-radius: calc(var(--radius) - 2px);
      background: transparent;
      color: var(--text2);
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      transition: all .2s;
    }

    .tab-btn.active {
      background: #2563eb;
      color: #fff;
    }

    .tab-panel {
      display: none;
    }

    .tab-panel.active {
      display: block;
    }
  </style>

  <div class="tab-bar">
    <button class="tab-btn active" id="tab-standard-btn" onclick="switchTab('standard')">🍞 Стандардни артикли</button>
    <button class="tab-btn" id="tab-market-btn" onclick="switchTab('market')">🏬 Артикли за маркети</button>
  </div>

  <!-- ══ TAB: STANDARD ARTICLES ══ -->
  <div class="tab-panel active" id="tab-standard">
    <div class="card-header"
      style="margin-bottom:20px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 20px">
      <span class="card-title">🍞 Стандардни артикли (<span id="cnt-standard">
          <%= articles.filter(a=>!a.is_market_article).length %>
        </span>)</span>
      <button class="btn btn-primary" style="background:#2563eb;border-color:#2563eb" onclick="openAddModal(0)">+ Додај
        артикл</button>
    </div>
    <div class="card">
      <div class="table-wrap">
        <% const stdArticles=articles.filter(a=> !a.is_market_article); %>
          <% if (stdArticles.length===0) { %>
            <div class="empty">
              <div class="empty-icon">🍞</div>
              <p>Нема стандардни артикли</p>
            </div>
            <% } else { %>
              <table id="art-table-std">
                <thead>
                  <tr>
                    <th>Ред</th>
                    <th>Код</th>
                    <th>Назив</th>
                    <th>Единица</th>
                    <th>Цена (ден.)</th>
                    <th>Акции</th>
                  </tr>
                </thead>
                <tbody>
                  <% stdArticles.forEach((a,i)=> { %>
                    <tr id="arow-<%= a.id %>">
                      <td>
                        <div class="move-btns">
                          <button class="btn-move" onclick="moveArticle(<%= a.id %>,'up')" title="Горе">▲</button>
                          <button class="btn-move" onclick="moveArticle(<%= a.id %>,'down')" title="Долу">▼</button>
                        </div>
                      </td>
                      <td><span class="badge badge-warn">
                          <%= a.code %>
                        </span></td>
                      <td><strong>
                          <%= a.name %>
                        </strong></td>
                      <td style="color:var(--text3)">
                        <%= a.unit %>
                      </td>
                      <td><strong style="color:var(--primary)">
                          <%= a.price.toFixed(2) %> ден.
                        </strong></td>
                      <td>
                        <div class="btn-group">
                          <button class="btn btn-sm btn-outline"
                            onclick='editArticle(<%= JSON.stringify(a) %>)'>✏️</button>
                          <button class="btn btn-sm btn-danger"
                            onclick="deleteArticle(<%= a.id %>, '<%= a.name.replace(/'/g," \\'") %>')">🗑️</button>
                        </div>
                      </td>
                    </tr>
                    <% }) %>
                </tbody>
              </table>
              <% } %>
      </div>
    </div>
  </div>

  <!-- ══ TAB: MARKET ARTICLES ══ -->
  <div class="tab-panel" id="tab-market">
    <div class="card-header"
      style="margin-bottom:20px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 20px">
      <span class="card-title">🏬 Артикли за маркети (<span id="cnt-market">
          <%= articles.filter(a=>a.is_market_article).length %>
        </span>)</span>
      <button class="btn btn-primary" onclick="openAddModal(1)">+ Додај артикл за маркет</button>
    </div>
    <div class="card">
      <div class="table-wrap">
        <% const mktArticles=articles.filter(a=> a.is_market_article); %>
          <% if (mktArticles.length===0) { %>
            <div class="empty">
              <div class="empty-icon">🏬</div>
              <p>Нема додадено артикли за маркети</p>
            </div>
            <% } else { %>
              <table id="art-table-mkt">
                <thead>
                  <tr>
                    <th>Ред</th>
                    <th>Код</th>
                    <th>Назив</th>
                    <th>Единица</th>
                    <th>Цена (ден.)</th>
                    <th>Акции</th>
                  </tr>
                </thead>
                <tbody>
                  <% mktArticles.forEach((a,i)=> { %>
                    <tr id="arow-<%= a.id %>">
                      <td>
                        <div class="move-btns">
                          <button class="btn-move" onclick="moveArticle(<%= a.id %>,'up')" title="Горе">▲</button>
                          <button class="btn-move" onclick="moveArticle(<%= a.id %>,'down')" title="Долу">▼</button>
                        </div>
                      </td>
                      <td><span class="badge badge-info">
                          <%= a.code %>
                        </span></td>
                      <td><strong>
                          <%= a.name %>
                        </strong></td>
                      <td style="color:var(--text3)">
                        <%= a.unit %>
                      </td>
                      <td><strong style="color:var(--primary)">
                          <%= a.price.toFixed(2) %> ден.
                        </strong></td>
                      <td>
                        <div class="btn-group">
                          <button class="btn btn-sm btn-outline"
                            onclick='editArticle(<%= JSON.stringify(a) %>)'>✏️</button>
                          <button class="btn btn-sm btn-danger"
                            onclick="deleteArticle(<%= a.id %>, '<%= a.name.replace(/'/g," \\'") %>')">🗑️</button>
                        </div>
                      </td>
                    </tr>
                    <% }) %>
                </tbody>
              </table>
              <% } %>
      </div>
    </div>
  </div>

  <!-- Add Modal -->
  <div class="modal-overlay" id="modal-add">
    <div class="modal">
      <div class="modal-header">
        <h3 id="add-modal-title">Додај артикл</h3><button class="modal-close"
          onclick="closeModal('modal-add')">✕</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="add-is-market-article" value="0">
        <div class="form-row cols-2">
          <div class="field"><label>Код</label><input id="add-code" placeholder="814"></div>
          <div class="field"><label>Единица</label><select id="add-unit">
              <option value="kom">kom</option>
              <option value="kg">kg</option>
            </select></div>
        </div>
        <div class="form-row">
          <div class="field"><label>Екстерен Код (Matrix)</label><input id="add-external-code"
              placeholder="пр. 6000814"></div>
        </div>
        <div class="form-row">
          <div class="field"><label>Назив *</label><input id="add-name" placeholder="Бел леб..."></div>
        </div>
        <div class="form-row">
          <div class="field"><label>Цена (ден.)</label><input id="add-price" type="number" step="0.01"
              placeholder="0.00"></div>
        </div>
      </div>
      <div class="modal-footer"><button class="btn btn-outline" onclick="closeModal('modal-add')">Откажи</button><button
          class="btn btn-primary" onclick="addArticle()">Зачувај</button></div>
    </div>
  </div>

  <!-- Edit Modal -->
  <div class="modal-overlay" id="modal-edit">
    <div class="modal">
      <div class="modal-header">
        <h3>Уреди артикл</h3><button class="modal-close" onclick="closeModal('modal-edit')">✕</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="edit-id">
        <input type="hidden" id="edit-is-market-article" value="0">
        <div class="form-row cols-2">
          <div class="field"><label>Код</label><input id="edit-code"></div>
          <div class="field"><label>Единица</label><select id="edit-unit">
              <option value="kom">kom</option>
              <option value="kg">kg</option>
            </select></div>
        </div>
        <div class="form-row">
          <div class="field"><label>Екстерен Код (Matrix)</label><input id="edit-external-code"></div>
        </div>
        <div class="form-row">
          <div class="field"><label>Назив *</label><input id="edit-name"></div>
        </div>
        <div class="form-row">
          <div class="field"><label>Цена (ден.)</label><input id="edit-price" type="number" step="0.01"></div>
        </div>
      </div>
      <div class="modal-footer"><button class="btn btn-outline"
          onclick="closeModal('modal-edit')">Откажи</button><button class="btn btn-primary"
          onclick="updateArticle()">Зачувај</button></div>
    </div>
  </div>

  <script>
    function switchTab(tab) {
      document.getElementById('tab-standard').classList.toggle('active', tab === 'standard');
      document.getElementById('tab-market').classList.toggle('active', tab === 'market');
      document.getElementById('tab-standard-btn').classList.toggle('active', tab === 'standard');
      document.getElementById('tab-market-btn').classList.toggle('active', tab === 'market');
    }
    function openAddModal(isMarket) {
      document.getElementById('add-is-market-article').value = isMarket;
      document.getElementById('add-modal-title').textContent = isMarket ? 'Додај артикл за маркет' : 'Додај стандарден артикл';
      document.getElementById('add-code').value = '';
      document.getElementById('add-external-code').value = '';
      document.getElementById('add-name').value = '';
      document.getElementById('add-price').value = '';
      document.getElementById('add-unit').value = 'kom';
      openModal('modal-add');
    }
    async function addArticle() {
      const r = await fetch('/admin/api/articles', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code: document.getElementById('add-code').value, external_code: document.getElementById('add-external-code').value, name: document.getElementById('add-name').value, price: document.getElementById('add-price').value, unit: document.getElementById('add-unit').value, is_market_article: parseInt(document.getElementById('add-is-market-article').value) }) });
      const d = await r.json();
      if (d.success) { toast('Артиклот е додаден!'); setTimeout(() => location.reload(), 800) } else toast(d.error, 'error');
    }
    function editArticle(a) {
      document.getElementById('edit-id').value = a.id;
      document.getElementById('edit-is-market-article').value = a.is_market_article || 0;
      document.getElementById('edit-code').value = a.code || '';
      document.getElementById('edit-external-code').value = a.external_code || '';
      document.getElementById('edit-name').value = a.name || '';
      document.getElementById('edit-price').value = a.price || 0;
      document.getElementById('edit-unit').value = a.unit || 'kom';
      openModal('modal-edit');
    }
    async function updateArticle() {
      const id = document.getElementById('edit-id').value;
      const r = await fetch('/admin/api/articles/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code: document.getElementById('edit-code').value, external_code: document.getElementById('edit-external-code').value, name: document.getElementById('edit-name').value, price: document.getElementById('edit-price').value, unit: document.getElementById('edit-unit').value, is_market_article: parseInt(document.getElementById('edit-is-market-article').value) }) });
      const d = await r.json();
      if (d.success) { toast('Зачувано!'); setTimeout(() => location.reload(), 800) } else toast(d.error, 'error');
    }
    async function deleteArticle(id, name) {
      if (!confirm(`Избриши артикл "${name}"?`)) return;
      const r = await fetch('/admin/api/articles/' + id, { method: 'DELETE' });
      const d = await r.json();
      if (d.success) { document.getElementById('arow-' + id).remove(); toast('Артиклот е избришан'); } else toast(d.error, 'error');
    }
    async function moveArticle(id, dir) {
      const r = await fetch('/admin/api/articles/' + id + '/move', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ direction: dir }) });
      const d = await r.json();
      if (d.success) location.reload(); else toast(d.error, 'error');
    }
  </script>

  <%- include('_footer') %>