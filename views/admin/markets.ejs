<%- include('_header', { title: 'Пазари', page: 'markets' }) %>

<style>
.tab-bar { display:flex; gap:4px; margin-bottom:20px; background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:6px; }
.tab-btn { flex:1; padding:8px 16px; border:none; border-radius:calc(var(--radius) - 2px); background:transparent; color:var(--text2); font-weight:600; font-size:14px; cursor:pointer; transition:all .2s; }
.tab-btn.active { background:#2563eb; color:#fff; }
.tab-btn.active-large { background:#7c3aed; color:#fff; }
.tab-panel { display:none; }
.tab-panel.active { display:block; }
.large-badge { background:#ede9fe; color:#7c3aed; font-size:11px; padding:2px 8px; border-radius:6px; font-weight:700; margin-left:6px; }
.articles-modal-list { max-height:400px; overflow-y:auto; display:flex; flex-direction:column; gap:6px; padding-right:4px; }
.art-check-row { display:flex; align-items:center; gap:10px; padding:8px 12px; background:var(--surface2); border:1px solid var(--border); border-radius:8px; cursor:pointer; }
.art-check-row:hover { background:var(--surface); }
.art-check-row input[type=checkbox] { width:18px; height:18px; cursor:pointer; accent-color:#2563eb; }
.art-check-row label { cursor:pointer; flex:1; font-size:14px; }
.art-section-title { font-size:12px; font-weight:700; color:var(--text3); text-transform:uppercase; letter-spacing:.5px; margin:10px 0 4px; }
</style>

<div class="tab-bar">
  <button class="tab-btn active" id="tab-normal-btn" onclick="switchTab('normal')">🏪 Обични пазари</button>
  <button class="tab-btn" id="tab-large-btn" onclick="switchTab('large')">🏬 Големи маркети</button>
</div>

<!-- ══ TAB: NORMAL MARKETS ══ -->
<div class="tab-panel active" id="tab-normal">
  <div class="card-header" style="margin-bottom:20px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 20px">
    <span class="card-title">🏪 Обични пазари</span>
    <button class="btn btn-primary" style="background:#2563eb;border-color:#2563eb" onclick="openAddModal(0)">+ Додај пазар</button>
  </div>
  <div class="card">
    <div class="table-wrap">
      <% const normalMarkets = markets.filter(m => !m.is_large); %>
      <% if (normalMarkets.length === 0) { %>
      <div class="empty"><div class="empty-icon">🏪</div><p>Нема додадени пазари</p></div>
      <% } else { %>
      <table>
        <thead><tr><th>#</th><th>Назив</th><th>Фирма</th><th>Шифра Клиент</th><th>Шифра Објект</th><th>Град</th><th>Адреса</th><th>Телефон</th><th>Акции</th></tr></thead>
        <tbody>
        <% normalMarkets.forEach((m,i) => { %>
          <tr id="row-<%= m.id %>">
            <td style="color:var(--text3)"><%= i+1 %></td>
            <td><strong><%= m.name %></strong></td>
            <td><% if(m.company_name){ %><span class="badge badge-info" style="font-size:11px"><%= m.company_name %></span><% } else { %>—<% } %></td>
            <td><%= m.client_code || '—' %></td>
            <td><%= m.object_code || '—' %></td>
            <td><%= m.city || '—' %></td>
            <td><%= m.address || '—' %></td>
            <td><%= m.contact_phone || '—' %></td>
            <td>
              <div class="btn-group">
                <button class="btn btn-sm btn-outline" onclick='editMarket(<%= JSON.stringify(m) %>)'>✏️ Уреди</button>
                <button class="btn btn-sm btn-danger" onclick="deleteMarket(<%= m.id %>, '<%= m.name.replace(/'/g,"\\'") %>')">🗑️</button>
              </div>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
</div>

<!-- ══ TAB: LARGE MARKETS ══ -->
<div class="tab-panel" id="tab-large">
  <div class="card-header" style="margin-bottom:20px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 20px">
    <span class="card-title">🏬 Големи маркети</span>
    <button class="btn btn-primary" style="background:#7c3aed;border-color:#7c3aed" onclick="openAddModal(1)">+ Додај голем маркет</button>
  </div>
  <div class="card">
    <div class="table-wrap">
      <% const largeMarkets = markets.filter(m => m.is_large); %>
      <% if (largeMarkets.length === 0) { %>
      <div class="empty"><div class="empty-icon">🏬</div><p>Нема додадено Големи маркети</p><p style="font-size:13px;color:var(--text3)">Додај маркет со Matrix колона за автоматско нарачување</p></div>
      <% } else { %>
      <table>
        <thead><tr><th>#</th><th>Назив</th><th>Matrix Колона</th><th>Фирма</th><th>Адреса</th><th>Телефон</th><th>Акции</th></tr></thead>
        <tbody>
        <% largeMarkets.forEach((m,i) => { %>
          <tr id="row-<%= m.id %>">
            <td style="color:var(--text3)"><%= i+1 %></td>
            <td><strong><%= m.name %></strong><span class="large-badge">ГОЛЕМ</span></td>
            <td><span class="badge badge-warn"><%= m.portal_column_id || '—' %></span></td>
            <td><% if(m.company_name){ %><span class="badge badge-info" style="font-size:11px"><%= m.company_name %></span><% } else { %>—<% } %></td>
            <td><%= m.address || '—' %></td>
            <td><%= m.contact_phone || '—' %></td>
            <td>
              <div class="btn-group">
                <button class="btn btn-sm btn-outline" onclick='editMarket(<%= JSON.stringify(m) %>)'>✏️ Уреди</button>
                <button class="btn btn-sm btn-primary" style="background:#7c3aed;border-color:#7c3aed" onclick="openArticlesModal(<%= m.id %>, '<%= m.name.replace(/'/g,"\\'") %>')">📦 Артикли</button>
                <button class="btn btn-sm btn-danger" onclick="deleteMarket(<%= m.id %>, '<%= m.name.replace(/'/g,"\\'") %>')">🗑️</button>
              </div>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
</div>

<!-- ══ ADD MODAL ══ -->
<div class="modal-overlay" id="modal-add">
  <div class="modal">
    <div class="modal-header"><h3 id="add-modal-title">Додај пазар</h3><button class="modal-close" onclick="closeModal('modal-add')">✕</button></div>
    <div class="modal-body">
      <input type="hidden" id="add-is-large" value="0">
      <div class="form-row cols-2"><div class="field"><label>Назив (Опис) *</label><input id="add-name" placeholder="Маркет Центар"></div><div class="field"><label>Шифра на Клиент</label><input id="add-client-code"></div></div>
      <div class="form-row cols-2"><div class="field"><label>Шифра на Објект</label><input id="add-object-code"></div><div class="field"><label>Град</label><input id="add-city" value="KUMANOVO"></div></div>
      <div class="form-row cols-2"><div class="field"><label>Адреса</label><input id="add-addr" placeholder="ул. ..."></div><div class="field"><label>Телефон</label><input id="add-phone" type="tel"></div></div>
      <div id="add-portal-col-wrap" class="form-row" style="display:none"><div class="field"><label>🔗 Matrix Колона (Portal Column ID)</label><input id="add-portal-col" placeholder="пр. КИТ-ГО ДООЕЛ (080) ..."></div></div>
      <div class="field"><label>🏢 Фирма (опционално)</label>
        <select id="add-company">
          <option value="">— Без фирма —</option>
          <% companies.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
        </select>
      </div>
    </div>
    <div class="modal-footer"><button class="btn btn-outline" onclick="closeModal('modal-add')">Откажи</button><button class="btn btn-primary" onclick="addMarket()">Зачувај</button></div>
  </div>
</div>

<!-- ══ EDIT MODAL ══ -->
<div class="modal-overlay" id="modal-edit">
  <div class="modal">
    <div class="modal-header"><h3>Уреди пазар</h3><button class="modal-close" onclick="closeModal('modal-edit')">✕</button></div>
    <div class="modal-body">
      <input type="hidden" id="edit-id">
      <input type="hidden" id="edit-is-large" value="0">
      <div class="form-row cols-2"><div class="field"><label>Назив (Опис) *</label><input id="edit-name"></div><div class="field"><label>Шифра на Клиент</label><input id="edit-client-code"></div></div>
      <div class="form-row cols-2"><div class="field"><label>Шифра на Објект</label><input id="edit-object-code"></div><div class="field"><label>Град</label><input id="edit-city"></div></div>
      <div class="form-row cols-2"><div class="field"><label>Адреса</label><input id="edit-addr"></div><div class="field"><label>Телефон</label><input id="edit-phone" type="tel"></div></div>
      <div id="edit-portal-col-wrap" class="form-row" style="display:none"><div class="field"><label>🔗 Matrix Колона (Portal Column ID)</label><input id="edit-portal-col" placeholder="пр. КИТ-ГО ДООЕЛ (080) ..."></div></div>
      <div class="field"><label>🏢 Фирма (опционално)</label>
        <select id="edit-company">
          <option value="">— Без фирма —</option>
          <% companies.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
        </select>
      </div>
    </div>
    <div class="modal-footer"><button class="btn btn-outline" onclick="closeModal('modal-edit')">Откажи</button><button class="btn btn-primary" onclick="updateMarket()">Зачувај</button></div>
  </div>
</div>

<!-- ══ ARTICLES MODAL (for large markets) ══ -->
<div class="modal-overlay" id="modal-articles">
  <div class="modal" style="max-width:560px">
    <div class="modal-header">
      <h3>📦 Артикли за: <span id="art-modal-market-name"></span></h3>
      <button class="modal-close" onclick="closeModal('modal-articles')">✕</button>
    </div>
    <div class="modal-body">
      <p style="font-size:13px;color:var(--text3);margin-bottom:12px">Избери кои артикли ги нарачува овој маркет. Возачот ќе гледа само избраните.</p>
      <input type="text" id="art-search" placeholder="🔍 Пребарај артикл..." onkeyup="filterArticles()" style="width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:8px;font-size:14px;margin-bottom:12px;background:var(--surface);color:var(--text);outline:none">
      <div id="art-modal-list" class="articles-modal-list"><!-- filled by JS --></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-outline" onclick="closeModal('modal-articles')">Откажи</button>
      <button class="btn btn-primary" style="background:#7c3aed;border-color:#7c3aed" onclick="saveMarketArticles()">💾 Зачувај</button>
    </div>
  </div>
</div>

<script>
// All articles passed from backend (injected below)
const ALL_ARTICLES = <%- JSON.stringify(allArticles) %>;
let currentArticlesMarketId = null;

function switchTab(tab) {
  document.getElementById('tab-normal').classList.toggle('active', tab === 'normal');
  document.getElementById('tab-large').classList.toggle('active', tab === 'large');
  document.getElementById('tab-normal-btn').classList.toggle('active', tab === 'normal');
  document.getElementById('tab-large-btn').classList.toggle('active', tab === 'large');
}

function openAddModal(isLarge) {
  document.getElementById('add-is-large').value = isLarge;
  document.getElementById('add-modal-title').textContent = isLarge ? 'Додај голем маркет' : 'Додај пазар';
  document.getElementById('add-portal-col-wrap').style.display = isLarge ? '' : 'none';
  document.getElementById('add-name').value = '';
  document.getElementById('add-client-code').value = '';
  document.getElementById('add-object-code').value = '';
  document.getElementById('add-city').value = 'KUMANOVO';
  document.getElementById('add-addr').value = '';
  document.getElementById('add-phone').value = '';
  document.getElementById('add-portal-col').value = '';
  document.getElementById('add-company').value = '';
  openModal('modal-add');
}

async function addMarket() {
  const isLarge = parseInt(document.getElementById('add-is-large').value);
  const r = await fetch('/admin/api/markets',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
    name:document.getElementById('add-name').value,
    address:document.getElementById('add-addr').value,
    city:document.getElementById('add-city').value,
    client_code:document.getElementById('add-client-code').value,
    object_code:document.getElementById('add-object-code').value,
    contact_phone:document.getElementById('add-phone').value,
    company_id:document.getElementById('add-company').value||null,
    is_large: isLarge,
    portal_column_id: isLarge ? document.getElementById('add-portal-col').value : null
  })});
  const d = await r.json();
  if(d.success){toast('Пазарот е додаден!');setTimeout(()=>location.reload(),800)}else toast(d.error,'error');
}

function editMarket(m) {
  document.getElementById('edit-id').value=m.id;
  document.getElementById('edit-is-large').value=m.is_large||0;
  document.getElementById('edit-name').value=m.name||'';
  document.getElementById('edit-client-code').value=m.client_code||'';
  document.getElementById('edit-object-code').value=m.object_code||'';
  document.getElementById('edit-city').value=m.city||'';
  document.getElementById('edit-addr').value=m.address||'';
  document.getElementById('edit-phone').value=m.contact_phone||'';
  document.getElementById('edit-company').value=m.company_id||'';
  document.getElementById('edit-portal-col').value=m.portal_column_id||'';
  document.getElementById('edit-portal-col-wrap').style.display = m.is_large ? '' : 'none';
  openModal('modal-edit');
}

async function updateMarket() {
  const id=document.getElementById('edit-id').value;
  const isLarge=parseInt(document.getElementById('edit-is-large').value);
  const r=await fetch('/admin/api/markets/'+id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({
    name:document.getElementById('edit-name').value,
    address:document.getElementById('edit-addr').value,
    city:document.getElementById('edit-city').value,
    client_code:document.getElementById('edit-client-code').value,
    object_code:document.getElementById('edit-object-code').value,
    contact_phone:document.getElementById('edit-phone').value,
    company_id:document.getElementById('edit-company').value||null,
    is_large: isLarge,
    portal_column_id: isLarge ? document.getElementById('edit-portal-col').value : null
  })});
  const d=await r.json();
  if(d.success){toast('Зачувано!');setTimeout(()=>location.reload(),800)}else toast(d.error,'error');
}

async function deleteMarket(id,name) {
  if(!confirm(`Избриши пазар "${name}"?`))return;
  const r=await fetch('/admin/api/markets/'+id,{method:'DELETE'});
  const d=await r.json();
  if(d.success){document.getElementById('row-'+id).remove();toast('Пазарот е избришан');}else toast(d.error,'error');
}

// ── Articles Modal ──
async function openArticlesModal(marketId, marketName) {
  currentArticlesMarketId = marketId;
  document.getElementById('art-modal-market-name').textContent = marketName;
  document.getElementById('art-search').value = '';
  // Load currently selected articles for this market
  const res = await fetch('/admin/api/markets/' + marketId + '/articles');
  const selected = await res.json(); // array of article ids
  const selectedSet = new Set(selected.map(r => r.article_id));

  renderArticlesList(selectedSet, '');
  openModal('modal-articles');
}

function renderArticlesList(selectedSet, filter) {
  const list = document.getElementById('art-modal-list');
  const std = ALL_ARTICLES.filter(a => !a.is_market_article && (!filter || a.name.toLowerCase().includes(filter) || a.code.toLowerCase().includes(filter)));
  const mkt = ALL_ARTICLES.filter(a => a.is_market_article && (!filter || a.name.toLowerCase().includes(filter) || a.code.toLowerCase().includes(filter)));
  
  list.innerHTML = '';
  if (std.length > 0) {
    list.innerHTML += `<div class="art-section-title">🍞 Стандардни артикли</div>`;
    std.forEach(a => {
      const chk = selectedSet.has(a.id) ? 'checked' : '';
      list.innerHTML += `<div class="art-check-row"><input type="checkbox" id="ac-${a.id}" value="${a.id}" ${chk}><label for="ac-${a.id}"><span style="font-size:12px;color:var(--text3);margin-right:6px">${a.code}</span>${a.name}</label></div>`;
    });
  }
  if (mkt.length > 0) {
    list.innerHTML += `<div class="art-section-title">🏬 Артикли за маркети</div>`;
    mkt.forEach(a => {
      const chk = selectedSet.has(a.id) ? 'checked' : '';
      list.innerHTML += `<div class="art-check-row"><input type="checkbox" id="ac-${a.id}" value="${a.id}" ${chk}><label for="ac-${a.id}"><span style="font-size:12px;color:var(--text3);margin-right:6px">${a.code}</span>${a.name}</label></div>`;
    });
  }
  if (std.length === 0 && mkt.length === 0) {
    list.innerHTML = '<p style="color:var(--text3);font-size:14px;text-align:center;padding:20px">Нема артикли</p>';
  }
}

function filterArticles() {
  const filter = document.getElementById('art-search').value.toLowerCase();
  // Collect current checked state before re-render
  const checked = new Set([...document.querySelectorAll('#art-modal-list input[type=checkbox]:checked')].map(c=>parseInt(c.value)));
  renderArticlesList(checked, filter);
}

async function saveMarketArticles() {
  const articleIds = [...document.querySelectorAll('#art-modal-list input[type=checkbox]:checked')].map(c=>parseInt(c.value));
  const r = await fetch('/admin/api/markets/' + currentArticlesMarketId + '/articles', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ article_ids: articleIds })
  });
  const d = await r.json();
  if(d.success){toast('Артиклите се зачувани!');closeModal('modal-articles');}else toast(d.error,'error');
}
</script>

<%- include('_footer') %>
