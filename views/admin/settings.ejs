<%- include('_header', { title: 'Подесувања на профил' , page: 'settings' }) %>

<div style="max-width: 500px; margin: 0 auto; margin-top: 40px;">
  <div class="card">
    <div class="card-header">
      <span class="card-title">🔐 Промена на Корисничко име и Лозинка</span>
    </div>
    <div style="padding: 24px;">

      <% if (error) { %>
        <div style="background: #fef2f2; color: #991b1b; padding: 12px; border-radius: 8px; border: 1px solid #fecaca; margin-bottom: 20px; font-weight: 600; font-size: 14px;">
          ⚠️ <%= error %>
        </div>
      <% } %>

      <% if (success) { %>
        <div style="background: #f0fdf4; color: #166534; padding: 12px; border-radius: 8px; border: 1px solid #bbf7d0; margin-bottom: 20px; font-weight: 600; font-size: 14px;">
          ✅ <%= success %>
        </div>
      <% } %>

      <form method="POST" action="/admin/settings">
        <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px; color: var(--text2)">Име и Презиме (не се менува)</label>
        <input type="text" value="<%= admin.name %>" disabled style="width: 100%; padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface2); color: var(--text3); margin-bottom: 16px; outline: none;">

        <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px; color: var(--text2)">Корисничко име</label>
        <input type="text" name="username" value="<%= admin.username %>" required style="width: 100%; padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); color: var(--text); margin-bottom: 16px; outline: none; font-size: 15px;">

        <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px; color: var(--text2);">Нова лозинка</label>
        <div style="font-size: 12px; color: var(--text3); margin-bottom: 8px;">Оставете празно ако не сакате да ја промените лозинката.</div>
        <input type="password" name="password" placeholder="Внеси нова лозинка..." style="width: 100%; padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); color: var(--text); margin-bottom: 24px; outline: none; font-size: 15px;">

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; font-size: 15px; border-radius: 10px;">💾 Зачувај промени</button>
      </form>
    </div>
  </div>

  <!-- HOLIDAYS SECTION -->
  <div class="card" style="margin-top: 30px;">
    <div class="card-header">
      <span class="card-title">📅 Неработни денови (Празници)</span>
    </div>
    <div style="padding: 24px;">
      <div style="font-size: 13px; color: var(--text3); margin-bottom: 16px;">
        Додајте датуми кои се државни празници или неработни денови. Системот автоматски ќе ги прескокне овие денови при пресметка на следниот работен ден. (Неделите се прескокнуваат автоматски).
      </div>
      
      <div style="display: flex; gap: 10px; margin-bottom: 20px;">
        <input type="date" id="new-holiday-date" style="flex: 1; padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); color: var(--text); outline: none; font-size: 15px;">
        <button onclick="addHoliday()" class="btn btn-primary" style="padding: 0 20px; border-radius: 8px;">➕ Додај</button>
      </div>

      <div id="holidays-list" style="display: flex; flex-direction: column; gap: 8px;">
        <!-- Loaded via JS -->
      </div>
    </div>
  </div>
</div>

<script>
async function loadHolidays() {
  const res = await fetch('/admin/api/holidays');
  const holidays = await res.json();
  const list = document.getElementById('holidays-list');
  list.innerHTML = '';
  if (holidays.length === 0) {
    list.innerHTML = '<div style="color: var(--text3); font-size: 14px; font-style: italic;">Нема додадено празници.</div>';
    return;
  }
  holidays.forEach(h => {
    const div = document.createElement('div');
    div.style = "display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: var(--surface2); border: 1px solid var(--border); border-radius: 8px;";
    
    // Format date for display
    const d = new Date(h.date);
    const formatted = d.toLocaleDateString('mk-MK', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    
    div.innerHTML = `
      <span style="font-weight: 600; color: var(--text);">${formatted}</span>
      <button onclick="deleteHoliday('${h.date}')" class="btn btn-danger btn-sm" style="padding: 4px 10px; font-size: 12px; border-radius: 6px;">❌ Бриши</button>
    `;
    list.appendChild(div);
  });
}

async function addHoliday() {
  const date = document.getElementById('new-holiday-date').value;
  if (!date) return alert('Изберете датум');
  
  const res = await fetch('/admin/api/holidays', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ date })
  });
  if (res.ok) {
    document.getElementById('new-holiday-date').value = '';
    loadHolidays();
  }
}

async function deleteHoliday(date) {
  if (!confirm(`Дали сте сигурни дека сакате да го избришете празникот на ${date}?`)) return;
  const res = await fetch('/admin/api/holidays/' + date, { method: 'DELETE' });
  if (res.ok) loadHolidays();
}

// Load on mount
document.addEventListener('DOMContentLoaded', loadHolidays);
</script>

<%- include('_footer') %>
